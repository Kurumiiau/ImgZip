<Window x:Class="ImgZip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片压缩器" Width="1140" Height="892" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextElement.Foreground="#4C3A41"
        FontFamily="{StaticResource F.UI}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </Window.Resources>

    <!-- 外层留白：给窗口投影腾出空间 -->
    <Grid Margin="16">
        <Border x:Name="Shell" CornerRadius="24" Background="{StaticResource B.WindowBg}" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.26" Color="#8A6B76" />
            </Border.Effect>

            <Grid>
                <!-- ════════ 背景层 1：清晰色斑（露在窗口边缘，形成"玻璃外"的对比）════════ -->
                <Canvas x:Name="BgCrisp" ClipToBounds="True" IsHitTestVisible="False">
                    <Canvas.Background>
                        <LinearGradientBrush StartPoint="0.05,0" EndPoint="0.95,1">
                            <GradientStop Color="#FDF3F4" Offset="0" />
                            <GradientStop Color="#F9E3E6" Offset="0.4" />
                            <GradientStop Color="#F2E0E8" Offset="0.7" />
                            <GradientStop Color="#E3E6F0" Offset="1" />
                        </LinearGradientBrush>
                    </Canvas.Background>
                    <Ellipse Width="820" Height="820" Canvas.Left="-260" Canvas.Top="-320" Opacity="0.95">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#EB9FAA" Offset="0" />
                                <GradientStop Color="#00EB9FAA" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="700" Height="700" Canvas.Left="760" Canvas.Top="-220" Opacity="0.9">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#C0CEE4" Offset="0" />
                                <GradientStop Color="#00C0CEE4" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="900" Height="900" Canvas.Left="180" Canvas.Top="520" Opacity="0.85">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#F7D2D5" Offset="0" />
                                <GradientStop Color="#00F7D2D5" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="520" Height="520" Canvas.Left="-160" Canvas.Top="660" Opacity="0.8">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#C0CEE4" Offset="0" />
                                <GradientStop Color="#00C0CEE4" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Canvas>

                <!-- ════════ 背景层 2：模糊副本 —— 玻璃面板"透过去"看到的就是它 ════════ -->
                <Canvas ClipToBounds="True" IsHitTestVisible="False" Opacity="0.92">
                    <Canvas.CacheMode>
                        <BitmapCache RenderAtScale="0.5" SnapsToDevicePixels="False" />
                    </Canvas.CacheMode>
                    <Canvas.Effect>
                        <BlurEffect Radius="44" KernelType="Gaussian" RenderingBias="Performance" />
                    </Canvas.Effect>
                    <Canvas.Background>
                        <LinearGradientBrush StartPoint="0.05,0" EndPoint="0.95,1">
                            <GradientStop Color="#FDF3F4" Offset="0" />
                            <GradientStop Color="#F9E3E6" Offset="0.4" />
                            <GradientStop Color="#F2E0E8" Offset="0.7" />
                            <GradientStop Color="#E3E6F0" Offset="1" />
                        </LinearGradientBrush>
                    </Canvas.Background>
                    <Ellipse Width="820" Height="820" Canvas.Left="-260" Canvas.Top="-320">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#EB9FAA" Offset="0" />
                                <GradientStop Color="#00EB9FAA" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="700" Height="700" Canvas.Left="760" Canvas.Top="-220">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#C0CEE4" Offset="0" />
                                <GradientStop Color="#00C0CEE4" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="900" Height="900" Canvas.Left="180" Canvas.Top="520">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#F7D2D5" Offset="0" />
                                <GradientStop Color="#00F7D2D5" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="520" Height="520" Canvas.Left="-160" Canvas.Top="660">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#C0CEE4" Offset="0" />
                                <GradientStop Color="#00C0CEE4" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Canvas>

                <!-- ════════ 内容 ════════ -->
                <Grid x:Name="RootGrid" AllowDrop="True" Background="Transparent"
                      DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ─────────── 顶部 ─────────── -->
                    <Grid Grid.Row="0" Height="64" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                        <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                            <!-- 应用图标：玻璃方块 + 星芒 -->
                            <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource B.RoseGrad}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#C9737F" />
                                </Border.Effect>
                                <Grid>
                                    <Path Data="M4,16 L10,16 M7,12.5 L10.5,16 L7,19.5 M22,16 L16,16 M19,12.5 L15.5,16 L19,19.5 M13,9.5 L13,22.5"
                                          Stroke="#FFF8F9" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="图片压缩器" Style="{StaticResource T.H1}" VerticalAlignment="Center" />
                                    <!-- 署名 -->
                                    <Border CornerRadius="7" Background="#59EB9FAA" BorderBrush="#66FFFFFF" BorderThickness="1"
                                            Padding="8,1.5" Margin="9,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="by Kurumiiau" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource B.RoseDeep}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="拖入图片 · 自定义倍率或分辨率 · 一键压缩" Style="{StaticResource T.Sub}"
                                           FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Button x:Name="BtnMin" Style="{StaticResource Btn.Icon}" Click="OnMinimize" ToolTip="最小化">
                                <Path Data="M0,0 L12,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                            <Button x:Name="BtnClose" Style="{StaticResource Btn.Close}" Click="OnClose" ToolTip="关闭" Margin="4,0,0,0">
                                <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ─────────── 主体 ─────────── -->
                    <Grid Grid.Row="1" Margin="24,4,24,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="352" />
                        </Grid.ColumnDefinitions>

                        <!-- ══ 左：拖拽区 + 队列 ══ -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 拖拽区：高度由内容决定（不再写死，避免内容压出边框） -->
                            <Border x:Name="DropZone" Grid.Row="0" Style="{StaticResource Glass}"
                                    Padding="14" AllowDrop="True" MinHeight="120">
                                <Grid>
                                    <Border x:Name="DropDash" CornerRadius="14" Margin="0"
                                            BorderBrush="#66EB9FAA" BorderThickness="1.5" />
                                    <StackPanel x:Name="DropContent" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Margin="26,20">
                                        <Border x:Name="DropIconWrap" Width="52" Height="52" CornerRadius="17"
                                                Background="#8CFFFFFF" BorderBrush="#B3FFFFFF" BorderThickness="1"
                                                HorizontalAlignment="Center">
                                            <Path x:Name="DropIcon"
                                                  Data="M4,20 L4,26 A2,2 0 0 0 6,28 L26,28 A2,2 0 0 0 28,26 L28,20 M16,4 L16,20 M16,20 L10,14 M16,20 L22,14"
                                                  Stroke="{StaticResource B.Rose}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <TranslateTransform Y="0" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Border>
                                        <TextBlock x:Name="DropTitle" Text="把图片拖到这里" FontSize="14" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                                        <TextBlock x:Name="DropSub" Text="支持 PNG · JPEG · WebP · BMP · GIF · TIFF · ICO 等任意常见与冷门格式"
                                                   Style="{StaticResource T.Sub}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        <StackPanel x:Name="DropButtons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                            <Button Content="选择图片" Style="{StaticResource Btn.Glass}" Click="OnPickFiles" />
                                            <Button Content="选择文件夹" Style="{StaticResource Btn.Glass}" Click="OnPickFolder" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 队列 -->
                            <Border Grid.Row="2" Style="{StaticResource Glass}" Padding="16,14,10,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="2,0,6,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="QueueTitle" Text="待处理" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Border x:Name="QueueBadge" CornerRadius="9" Background="{StaticResource B.Blossom}"
                                                    Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="QueueCount" Text="0" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource B.Ink}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="BtnClear" Content="清空" Style="{StaticResource Btn.Glass}"
                                                    Height="28" Padding="12,0" FontSize="11.5" Click="OnClearQueue" />
                                        </StackPanel>
                                    </Grid>

                                    <ListBox x:Name="Queue" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                             ItemContainerStyle="{StaticResource QueueItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="15" Background="#70FFFFFF" BorderBrush="#59FFFFFF" BorderThickness="1"
                                                        Padding="10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="54" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="28" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 缩略图 -->
                                                        <Border Grid.Column="0" Width="54" Height="54" CornerRadius="12"
                                                                Background="#59C0CEE4" ClipToBounds="True">
                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                        </Border>

                                                        <!-- 信息 -->
                                                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Sub}" FontSize="11"
                                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                            <Grid Margin="0,6,0,0" Height="14">
                                                                <TextBlock Text="{Binding Preview}" FontSize="11"
                                                                           Foreground="{StaticResource B.Haze}" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center" />
                                                                <ProgressBar Style="{StaticResource Pgr}" Value="{Binding Progress}"
                                                                             Width="120" HorizontalAlignment="Right"
                                                                             Visibility="{Binding IsWorking, Converter={StaticResource B2V}}" />
                                                            </Grid>
                                                        </StackPanel>

                                                        <!-- 状态 -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                    MinWidth="92">
                                                            <Border CornerRadius="9" Background="#66FFFFFF" Padding="9,3" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{Binding StatusBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Result.SizeText, FallbackValue=''}" FontSize="10.5"
                                                                       Foreground="{StaticResource B.InkFaint}" HorizontalAlignment="Right"
                                                                       Margin="0,5,0,0" />
                                                        </StackPanel>

                                                        <Button Grid.Column="3" Style="{StaticResource Btn.Icon}" Width="24" Height="24"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Click="OnRemoveItem" Tag="{Binding}" ToolTip="移除">
                                                            <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#8B727A" StrokeThickness="1.4"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- 空状态 -->
                                    <StackPanel x:Name="EmptyHint" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <TextBlock Text="还没有图片" FontSize="12.5" Foreground="{StaticResource B.InkFaint}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="把文件或文件夹拖进上方区域即可" FontSize="11" Foreground="{StaticResource B.InkFaint}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ══ 右：设置 ══ -->
                        <Border Grid.Column="2" Style="{StaticResource Glass}" Padding="18,16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>

                                    <!-- 压缩方式 -->
                                    <TextBlock Text="压缩方式" Style="{StaticResource T.Section}" />
                                    <Border CornerRadius="16" Background="#4DFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1">
                                        <UniformGrid Columns="2">
                                            <RadioButton x:Name="ModeScale" GroupName="Mode" Style="{StaticResource Seg.Item}"
                                                         Content="按倍率" IsChecked="True" Checked="OnModeChanged" />
                                            <RadioButton x:Name="ModeRes" GroupName="Mode" Style="{StaticResource Seg.Item}"
                                                         Content="按分辨率" Checked="OnModeChanged" />
                                        </UniformGrid>
                                    </Border>

                                    <!-- 倍率 -->
                                    <StackPanel x:Name="PanelScale" Margin="0,13,0,0">
                                        <Grid>
                                            <TextBlock Text="缩放倍率" Style="{StaticResource T.Label}" />
                                            <TextBlock x:Name="ScaleValue" Text="50%" HorizontalAlignment="Right"
                                                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource B.RoseDeep}" />
                                        </Grid>
                                        <Slider x:Name="ScaleSlider" Style="{StaticResource Sld}" Minimum="1" Maximum="100"
                                                Value="50" TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="OnScaleChanged" Margin="0,6,0,0" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <RadioButton Content="100%" Style="{StaticResource Chip}" Tag="100" Click="OnScaleChip" />
                                            <RadioButton Content="75%" Style="{StaticResource Chip}" Tag="75" Click="OnScaleChip" />
                                            <RadioButton Content="50%" Style="{StaticResource Chip}" Tag="50" Click="OnScaleChip"
                                                         IsChecked="True" />
                                            <RadioButton Content="25%" Style="{StaticResource Chip}" Tag="25" Click="OnScaleChip" />
                                            <RadioButton Content="10%" Style="{StaticResource Chip}" Tag="10" Click="OnScaleChip" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- 分辨率 -->
                                    <StackPanel x:Name="PanelRes" Margin="0,13,0,0" Visibility="Collapsed">
                                        <TextBlock Text="目标分辨率" Style="{StaticResource T.Label}" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ResW" Grid.Column="0" Style="{StaticResource Txt}" Text="1920"
                                                     TextChanged="OnResChanged" />
                                            <TextBlock Grid.Column="1" Text="×" Style="{StaticResource T.Label}" Margin="8,0" />
                                            <TextBox x:Name="ResH" Grid.Column="2" Style="{StaticResource Txt}" Text="1080"
                                                     TextChanged="OnResChanged" />
                                            <TextBlock Grid.Column="3" Text="px" Style="{StaticResource T.Label}" Margin="8,0,0,0" />
                                        </Grid>
                                        <CheckBox x:Name="LockAspect" Content="锁定宽高比" Style="{StaticResource Switch}"
                                                  IsChecked="True" Margin="0,10,0,0" Checked="OnResChanged" Unchecked="OnResChanged" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <RadioButton Content="1920×1080" Style="{StaticResource Chip}" Tag="1920,1080" Click="OnResChip" />
                                            <RadioButton Content="1280×720" Style="{StaticResource Chip}" Tag="1280,720" Click="OnResChip" />
                                            <RadioButton Content="800×600" Style="{StaticResource Chip}" Tag="800,600" Click="OnResChip" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <Border Height="1" Background="#3AC0CEE4" Margin="0,13,0,11" />

                                    <!-- 输出位置 -->
                                    <TextBlock Text="输出位置" Style="{StaticResource T.Section}" />
                                    <StackPanel>
                                        <RadioButton x:Name="OutSame" GroupName="Out" Content="与源文件同目录（追加 _compressed 后缀）"
                                                     Foreground="{StaticResource B.InkSoft}" FontSize="12" IsChecked="True"
                                                     Checked="OnOutChanged" />
                                        <RadioButton x:Name="OutCustom" GroupName="Out" Content="自定义目录"
                                                     Foreground="{StaticResource B.InkSoft}" FontSize="12" Margin="0,8,0,0"
                                                     Checked="OnOutChanged" />
                                        <Grid Margin="20,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource GlassInset}" Height="32" Padding="10,0">
                                                <TextBlock x:Name="OutPathText" Text="（未选择）" FontSize="11.5"
                                                           Foreground="{StaticResource B.InkFaint}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Button Grid.Column="1" Content="选择" Style="{StaticResource Btn.Glass}" Height="32"
                                                    Padding="12,0" FontSize="11.5" Margin="8,0,0,0" Click="OnPickOutputDir" />
                                        </Grid>
                                    </StackPanel>

                                    <Border Height="1" Background="#3AC0CEE4" Margin="0,13,0,11" />

                                    <!-- 格式与质量 -->
                                    <TextBlock Text="输出格式" Style="{StaticResource T.Section}" />
                                    <ComboBox x:Name="FormatBox" Style="{StaticResource Cmb}"
                                              ItemContainerStyle="{StaticResource CmbItem}" SelectionChanged="OnFormatChanged" />

                                    <Grid Margin="0,14,0,0">
                                        <TextBlock x:Name="QualityLabel" Text="JPEG 质量" Style="{StaticResource T.Label}" />
                                        <TextBlock x:Name="QualityValue" Text="82" HorizontalAlignment="Right"
                                                   FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource B.RoseDeep}" />
                                    </Grid>
                                    <Slider x:Name="QualitySlider" Style="{StaticResource Sld}" Minimum="1" Maximum="100"
                                            Value="82" TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="OnQualityChanged" Margin="0,4,0,0" />

                                    <Border Height="1" Background="#3AC0CEE4" Margin="0,13,0,11" />

                                    <!-- 色深压缩 -->
                                    <TextBlock Text="色深压缩" Style="{StaticResource T.Section}" />
                                    <ComboBox x:Name="DepthBox" Style="{StaticResource Cmb}"
                                              ItemContainerStyle="{StaticResource CmbItem}" SelectionChanged="OnDepthChanged" />
                                    <TextBlock Text="抖动（减色时保住层次）" Style="{StaticResource T.Label}" Margin="0,10,0,0" />
                                    <ComboBox x:Name="DitherBox" Style="{StaticResource Cmb}" Margin="0,4,0,0"
                                              ItemContainerStyle="{StaticResource CmbItem}" SelectionChanged="OnDepthOptionChanged" />
                                    <TextBlock x:Name="DepthHint" Text="索引色对 PNG / BMP / GIF 的体积下降最明显"
                                               Style="{StaticResource T.Sub}" FontSize="10.5" Margin="0,7,0,0" TextWrapping="Wrap" />

                                    <Border Height="1" Background="#3AC0CEE4" Margin="0,13,0,11" />

                                    <TextBlock Text="其它" Style="{StaticResource T.Section}" />
                                    <CheckBox x:Name="ChkShrinkOnly" Content="只缩小，不放大" Style="{StaticResource Switch}"
                                              IsChecked="True" Checked="OnOptionsChanged" Unchecked="OnOptionsChanged" />
                                    <CheckBox x:Name="ChkSkipBigger" Content="结果更大时自动跳过" Style="{StaticResource Switch}"
                                              IsChecked="True" Margin="0,8,0,0" Checked="OnOptionsChanged" Unchecked="OnOptionsChanged" />
                                    <CheckBox x:Name="ChkKeepTime" Content="保留文件时间戳" Style="{StaticResource Switch}"
                                              IsChecked="True" Margin="0,8,0,0" Checked="OnOptionsChanged" Unchecked="OnOptionsChanged" />
                                    <CheckBox x:Name="ChkRecursive" Content="选择文件夹时包含子目录" Style="{StaticResource Switch}"
                                              IsChecked="True" Margin="0,8,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ─────────── 底部 ─────────── -->
                    <Border Grid.Row="2" Margin="24,0,24,22" CornerRadius="20" Background="#A8FFFFFF"
                            BorderBrush="{StaticResource B.Stroke}" BorderThickness="1" Padding="18,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.12" Color="#7A5A66" />
                        </Border.Effect>
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="SumTitle" Text="总计" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock x:Name="SumDetail" Text="等待添加图片" Style="{StaticResource T.Sub}" FontSize="11" Margin="0,2,0,0" />
                                <TextBlock Text="© Kurumiiau" FontSize="10" Foreground="{StaticResource B.InkFaint}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnOpenOut" Content="打开输出目录" Style="{StaticResource Btn.Glass}"
                                        Click="OnOpenOutput" Visibility="Collapsed" />
                                <Button x:Name="BtnCancel" Content="停止" Style="{StaticResource Btn.Glass}" Margin="10,0,0,0"
                                        Click="OnCancel" Visibility="Collapsed" />
                                <Button x:Name="BtnRun" Content="开始压缩" Style="{StaticResource Btn.Primary}" Width="150"
                                        Margin="10,0,0,0" Click="OnRun" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 提示条 -->
                    <Border x:Name="Toast" Grid.Row="2" CornerRadius="14" Background="#F2FFF7F8" BorderBrush="#B3FFFFFF"
                            BorderThickness="1" Padding="16,9" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,96" Opacity="0" IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#7A5A66" />
                        </Border.Effect>
                        <TextBlock x:Name="ToastText" FontSize="12" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
