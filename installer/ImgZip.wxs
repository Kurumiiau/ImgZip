<?xml version="1.0" encoding="utf-8"?>
<!--
  图片压缩器 ImgZip · 安装包定义（WiX Toolset v5）
  · 用户级安装（不需要管理员权限），装到 %LOCALAPPDATA%\Programs\ImgZip
  · 创建开始菜单 + 桌面快捷方式
  · 在"应用和功能"中可卸载，带图标与版本号
  · 作者：Kurumiiau
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="图片压缩器 ImgZip"
           Manufacturer="Kurumiiau"
           Version="1.2.0"
           UpgradeCode="7E4B2E3A-9C41-4F0B-9E52-3D8A5C1B6F27"
           Scope="perUser"
           Language="2052"
           Codepage="65001"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="图片压缩器 ImgZip —— 支持任意格式的高质量图片与视频压缩工具（作者 Kurumiiau）"
                        Manufacturer="Kurumiiau" />

    <!-- 升级安装：自动替换旧版本 -->
    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的「图片压缩器」。请先卸载后再安装本版本。" />

    <!-- 全部文件打进 MSI 内部，只有一个安装包 -->
    <MediaTemplate EmbedCab="yes" />

    <!-- 卸载入口显示图标 -->
    <Icon Id="AppIcon" SourceFile="..\src\ImgZip\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Kurumiiau" />
    <Property Id="ARPCOMMENTS" Value="图片与视频压缩：按倍率、分辨率或色深（灰度/黑白）压缩，支持 MP4/MKV/AVI/WebM 等视频格式。作者：Kurumiiau" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="both" />

    <!--
      前置条件：.NET 8 桌面运行时
      .NET 运行时安装后会写入 sharedhost 键（x64）；用它做存在性判断。
    -->
    <Property Id="DOTNET8HOST" Secure="yes">
      <RegistrySearch Id="DotnetHostVersion" Type="raw" Root="HKLM"
                      Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedhost"
                      Name="Version" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR DOTNET8HOST"
             Message="本软件需要「.NET 8 桌面运行时 (x64)」才能运行。&#10;&#10;请先安装后重新运行本安装包：&#10;https://dotnet.microsoft.com/download/dotnet/8.0&#10;（选择 .NET Desktop Runtime 8 · x64）" />

    <!-- 安装目录：%LOCALAPPDATA%\Programs\ImgZip（用户级，无需管理员） -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="ImgZip" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="图片压缩器" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- 开始菜单快捷方式 -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="1B7C4D52-3E6A-4B18-9F73-2A5E8C4D1907">
        <Shortcut Id="StartMenuLink" Name="图片压缩器" Description="图片压缩器 ImgZip · by Kurumiiau"
                  Target="[INSTALLFOLDER]ImgZip.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveStartMenu" Directory="ProgramMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Kurumiiau\ImgZip" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- 桌面快捷方式 -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="8A2D6E71-5C93-4F2A-B1D8-6E4F3A7C5B92">
        <Shortcut Id="DesktopLink" Name="图片压缩器" Description="图片压缩器 ImgZip · by Kurumiiau"
                  Target="[INSTALLFOLDER]ImgZip.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Kurumiiau\ImgZip" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- 安装向导界面（许可页 + 选择安装目录） -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
  </Package>

  <!-- 打包 release\payload 目录下的全部文件 -->
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="..\release\payload\**" />
    </ComponentGroup>
  </Fragment>

</Wix>
